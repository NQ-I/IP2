+    def _phone_trace(self, raw, candidates, confirmed_tracked, phones, monitor, ensemble):
+        """Stage-by-stage explanation of THIS frame's phone decision (no effect on it).
+        stage: NONE (no box) / VERIFIER REJECTION / TRACKER: building evidence /
+        TRACKER GATE: weak evidence / ENSEMBLE: MONITOR (suspected) / CONFIRMED."""
+        tracks = self._tracker.get_all_tracks()
+        if phones:
+            stage = "CONFIRMED"
+        elif not raw:
+            stage = "NONE: no cell-phone box from the detector (YOLO miss if a phone is visible)"
+        elif not candidates:
+            stage = "VERIFIER REJECTION: every detector box was rejected"
+        elif not confirmed_tracked:
+            from modules.detection.phone_tracker import CONFIRM_THRESHOLD, MIN_POSITIVE_OBSERVATIONS
+            best = max(tracks, key=lambda t: t.positive_observation_count, default=None)
+            if best and best.positive_observation_count >= MIN_POSITIVE_OBSERVATIONS and best.buffer_score < CONFIRM_THRESHOLD:
+                # seen often enough, but each frame's evidence (0.55*YOLO + 0.45*verifier) is weak
+                stage = (f"TRACKER GATE: weak evidence ({best.positive_observation_count} obs, buffer "
