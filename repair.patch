+                    except Exception as exc:                     # noqa: BLE001
+                        ai_error["msg"] = f"{type(exc).__name__}: {exc}"
+            stop.wait(max(0.0, a.ai_interval - (time.time() - t)))
+    threading.Thread(target=ai_loop, daemon=True).start()
+
+    # wait for the first analysed frame (model load)
+    def frame_recs():
+        with rlock:
+            return [r for r in records if r.get("kind") == "frame"]
+    while time.time() - t0 < 180 and not frame_recs() and not ai_error["msg"]:
