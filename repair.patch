+    ap.add_argument("--neutral-secs", type=float, default=15.0)
+    ap.add_argument("--ready-secs", type=float, default=3.0, help="countdown before each step is measured")
+    ap.add_argument("--rest-secs", type=float, default=5.0, help="'return to normal' pause after each step")
+    ap.add_argument("--ai-interval", type=float, default=0.8, help="seconds between AI frames (exam page: 0.8)")
+    ap.add_argument("--only", default="", help="comma separated step numbers, e.g. 1,2,3,10")
+    ap.add_argument("--show", action="store_true", help="show a preview window (q aborts)")
+    ap.add_argument("--report", default="live_diag_report.json")
+    a = ap.parse_args()
+
+    tmp = tempfile.mkdtemp(prefix="live_diag_")
+    os.environ["DATABASE_URL"] = "sqlite:///" + os.path.join(tmp, "diag.db").replace("\\", "/")
+    os.environ["AI_ASYNC"] = "0"
