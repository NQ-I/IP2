+"""
+tools/fetch_test_assets.py — download the REAL third-party media used by
+tests/test_real_runtime_media.py into tests/assets/ (not shipped with the project).
+
+    python tools/fetch_test_assets.py
+
+They are public test inputs from other open-source repositories (head-turn GIFs,
+face photos, COCO photos with phones, speech and ESC-50 sounds).  They are used
+only to exercise the real pipeline; they are not a benchmark dataset and no
+accuracy is claimed from them.  Tests whose file is missing are SKIPPED.
+"""
+import os
+import sys
+import urllib.request
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+DEST = os.path.join(ROOT, "tests", "assets")
+GH = "https://raw.githubusercontent.com/"
+ASSETS = {
+    # one speaker turning the head far left/right (3DDFA_V2 demo output)
+    "headturn_out.gif": GH + "cleardusk/3DDFA_V2/master/docs/images/out.gif",
+    # webcam sequence with head up / down / left / right (3DDFA_V2 demo)
+    "headpose_webcam.gif": GH + "cleardusk/3DDFA_V2/master/docs/images/webcam.gif",
+    # webcam-style clip with downcast eyes while speaking
+    "headpose_demo.gif": GH + "yinguobing/head-pose-estimation/master/doc/demo.gif",
+    # the same person looking straight / to her left / to her right
+    "face_img10.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img10.jpg",
+    "face_img4.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img4.jpg",
+    "face_img1.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img1.jpg",
+    "face_img30.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img30.jpg",
+    # phone-free photos with phone-like objects (statuette base, dark fabric, hand-held microphone):
+    # a lower phone operating point turned these into CONFIRMED phones (report §11)
+    "face_img37.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img37.jpg",
+    "face_img54.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img54.jpg",
+    "face_img59.jpg": GH + "serengil/deepface/master/tests/unit/dataset/img59.jpg",
+    # COCO photos with real phones held by people
+    "phone_coco_536.jpg": GH + "CMU-Perceptual-Computing-Lab/openpose/master/examples/media/COCO_val2014_000000000536.jpg",
+    "phone_coco_395.jpg": GH + "CMU-Perceptual-Computing-Lab/openpose/master/examples/media/COCO_val2014_000000000395.jpg",
+    # speech (public domain) and keyboard typing (ESC-50)
+    "speech_jfk.flac": GH + "openai/whisper/main/tests/jfk.flac",
+    "esc50_keyboard_typing.wav": GH + "karolpiczak/ESC-50/master/audio/1-137-A-32.wav",
+}
+
+
+def fetch(url, path):
+    if os.path.isfile(path) and os.path.getsize(path) > 1000:
+        print(f"  ok (cached)  {os.path.basename(path)}")
+        return True
+    try:
+        with urllib.request.urlopen(url, timeout=60) as r, open(path, "wb") as f:
+            f.write(r.read())
+        print(f"  downloaded   {os.path.basename(path)} ({os.path.getsize(path) // 1024} KB)")
+        return True
+    except Exception as exc:                                     # noqa: BLE001
+        print(f"  FAILED       {os.path.basename(path)}: {exc}")
+        return False
+
+
+def main():
+    os.makedirs(DEST, exist_ok=True)
+    print(f"Test assets -> {DEST}")
+    ok = all([fetch(u, os.path.join(DEST, n)) for n, u in ASSETS.items()])
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
