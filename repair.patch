+"""
+tools/live_diag.py — REAL local diagnostic with YOUR webcam and microphone.
+
+It drives the project's OWN pipeline end to end — FaceAnalyzer (MediaPipe),
+PhoneDetector (YOLOv8m + verifier + tracker + ensemble), the shared YAMNet
+AudioAnalyzer + AudioPipeline, StudentWorker (calibration, temporal logic,
+events, current / cumulative risk) and SessionManager with a throw-away SQLite
+database.  No detector logic is duplicated here: frames are prepared exactly
+like the exam page sends them (raw camera image, 320x240, JPEG quality 0.65,
+one AI frame every 0.8 s) and audio exactly like /student/audio receives it
+(16 kHz mono, 1 s chunks).
+
+Windows PowerShell, from the project folder, with the SAME Python you use for run.py:
+
+    python tools\\live_diag.py
+    python tools\\live_diag.py --show                 # preview window (q = abort)
+    python tools\\live_diag.py --only 1,2,3,10        # selected steps
+    python tools\\live_diag.py --camera 1 --step-secs 10
+
+Steps (follow the prompts; hold each behaviour until the countdown ends):
+     1 neutral face      2 Head Left       3 Head Right      4 Head Up
+     5 Head Down         6 Eyes Left       7 Eyes Right      8 Eyes Up
+     9 Eyes Down        10 show phone     11 speak          12 silence
+    13 second person appears
+
+Every step ends with one verdict:
+    DETECTED | NOT DETECTED | SUPPRESSED — <reason> | MODEL MISS | PIPELINE ERROR
+Nothing is marked successful automatically: the verdict is computed from the
+events the real worker emitted and from its per-frame diagnostics.  A JSON report
+(live_diag_report.json) is written for the next debugging pass — please send it
+back together with the console output.
+
+Testing without a camera/microphone:  --video FILE  and/or  --audio FILE  replay
+files instead (the same pipeline runs).
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import datetime
+import json
+import os
+import platform
+import sys
+import tempfile
+import threading
+import time
+import traceback
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+if ROOT not in sys.path:
+    sys.path.insert(0, ROOT)
+os.chdir(ROOT)
+
+STEPS = [
+    # id, key, prompt, kind, expected
+    (1, "neutral", "Sit normally, face the camera, look at the screen.", "neutral", None),
+    (2, "head_left", "Turn your HEAD to YOUR LEFT (about 30-45 deg) and hold.", "head", "left"),
+    (3, "head_right", "Turn your HEAD to YOUR RIGHT (about 30-45 deg) and hold.", "head", "right"),
+    (4, "head_up", "Tilt your HEAD UP (look at the ceiling corner) and hold.", "head", "up"),
+    (5, "head_down", "Tilt your HEAD DOWN (look at your desk / lap) and hold.", "head", "down"),
+    (6, "eyes_left", "Keep your head still, look with your EYES to YOUR LEFT and hold.", "gaze", "left"),
+    (7, "eyes_right", "Keep your head still, look with your EYES to YOUR RIGHT and hold.", "gaze", "right"),
+    (8, "eyes_up", "Keep your head still, look with your EYES UP and hold.", "gaze", "up"),
+    (9, "eyes_down", "Keep your head still, look with your EYES DOWN and hold.", "gaze", "down"),
+    (10, "phone", "Hold a PHONE up in front of the camera (screen or back towards it) and keep it there.", "phone", None),
+    (11, "speak", "SPEAK normally (read something aloud) until the countdown ends.", "speak", None),
+    (12, "silence", "Stay SILENT.", "silence", None),
+    (13, "second_person", "Ask a SECOND PERSON to come into the camera view and stay.", "persons", None),
+]
+GAZE_LABEL = {"left": "Looking Left", "right": "Looking Right", "up": "Looking Up", "down": "Looking Down"}
+HEAD_LABEL = {"left": "Head Left", "right": "Head Right", "up": "Head Up", "down": "Head Down"}
+
+
+def banner(title):
+    print("\n" + "=" * 78 + f"\n{title}\n" + "=" * 78, flush=True)
+
+
+def versions():
+    out = {"python": sys.executable, "python_version": platform.python_version(),
+           "platform": platform.platform(), "project": ROOT,
+           "venv": sys.prefix if sys.prefix != getattr(sys, "base_prefix", sys.prefix) else "(none: system Python)"}
+    from importlib import metadata
+    dist = {"cv2": "opencv-python", "sklearn": "scikit-learn"}
+    for mod in ("numpy", "cv2", "mediapipe", "torch", "ultralytics", "tensorflow", "sklearn", "flask", "sounddevice"):
+        try:
+            m = __import__(mod)
+            try:
+                out[mod] = metadata.version(dist.get(mod, mod))
+            except metadata.PackageNotFoundError:
+                out[mod] = getattr(m, "__version__", "?")
+        except Exception as exc:                                 # noqa: BLE001
+            out[mod] = f"NOT AVAILABLE ({type(exc).__name__}: {exc})"[:120]
+    return out
+
+
+# ── sources ─────────────────────────────────────────────────────────────────
+class LatestFrame:
+    """Camera / video reader thread: keeps only the newest frame (latest wins)."""
+
+    def __init__(self, cam_index, video):
+        import cv2
+        self.cv2 = cv2
+        self.video = video
+        if video:
+            self.cap = cv2.VideoCapture(video)
+        else:
+            self.cap = cv2.VideoCapture(cam_index, cv2.CAP_DSHOW) if os.name == "nt" else cv2.VideoCapture(cam_index)
+            if not self.cap.isOpened():
+                self.cap = cv2.VideoCapture(cam_index)
+            self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
+            self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
+        self.ok = self.cap.isOpened()
+        self.frame = None
+        self.frames = 0
+        self.lock = threading.Lock()
+        self.stop = False
+        self.fps = self.cap.get(cv2.CAP_PROP_FPS) or 15.0
+        threading.Thread(target=self._run, daemon=True).start()
+
+    def _run(self):
+        while not self.stop:
+            ok, fr = self.cap.read()
+            if not ok:
+                if self.video:                       # loop the file
+                    self.cap.set(self.cv2.CAP_PROP_POS_FRAMES, 0)
+                    continue
+                time.sleep(0.05)
+                continue
+            with self.lock:
+                self.frame = fr
+                self.frames += 1
+            if self.video:
+                time.sleep(1.0 / max(1.0, self.fps))
+
+    def latest(self):
+        with self.lock:
+            return None if self.frame is None else self.frame.copy()
+
+
+class AudioFeeder:
+    """Microphone (sounddevice) or file -> AudioPipeline.submit(), 1 s chunks of 16 kHz mono."""
+
+    def __init__(self, pipeline, student_id, audio_file=None, device=None):
+        import numpy as np
+        self.np = np
+        self.pipe, self.sid = pipeline, student_id
+        self.error = None
+        self.chunks = 0
+        self.rms = collections.deque(maxlen=50)
+        self.stop = False
+        if audio_file:
+            threading.Thread(target=self._file, args=(audio_file,), daemon=True).start()
+        else:
+            threading.Thread(target=self._mic, args=(device,), daemon=True).start()
+
+    def _push(self, x):
+        x = self.np.asarray(x, dtype=self.np.float32).reshape(-1)
+        self.rms.append(float(self.np.sqrt(self.np.mean(x ** 2))) if x.size else 0.0)
+        self.pipe.submit(self.sid, x, 16000)
+        self.chunks += 1
+
+    def _mic(self, device):
+        try:
+            import sounddevice as sd
+            with sd.InputStream(samplerate=16000, channels=1, dtype="float32", blocksize=16000,
+                                device=device) as st:
+                while not self.stop:
+                    data, _ = st.read(16000)
+                    self._push(data[:, 0])
+        except Exception as exc:                                 # noqa: BLE001
+            self.error = f"{type(exc).__name__}: {exc}"
+
+    def _file(self, path):
+        try:
+            import soundfile as sf
+            x, sr = sf.read(path, dtype="float32", always_2d=True)
+            x = x.mean(axis=1)
+            if sr != 16000:
+                n = int(round(x.size * 16000 / sr))
+                x = self.np.interp(self.np.linspace(0, x.size - 1, n), self.np.arange(x.size), x).astype("float32")
+            i = 0
+            while not self.stop:
+                chunk = x[i:i + 16000]
+                if chunk.size < 16000:
+                    i = 0
+                    continue
+                self._push(chunk)
+                i += 16000
+                time.sleep(1.0)
+        except Exception as exc:                                 # noqa: BLE001
+            self.error = f"{type(exc).__name__}: {exc}"
+
+
+# ── verdicts ────────────────────────────────────────────────────────────────
+def _most_common(items, n=2):
+    c = collections.Counter(i for i in items if i)
+    return "; ".join(f"{k} (x{v})" for k, v in c.most_common(n))
+
+
+def _max_run(frames, pred):
+    """Longest continuous time (s) for which pred(frame) held."""
+    best, start = 0.0, None
+    for f in frames:
+        if pred(f):
+            start = f["ts"] if start is None else start
+            best = max(best, f["ts"] - start)
+        else:
+            start = None
+    return best
+
+
+def verdict(step, frames, audio, events, ctx):
+    _, key, _, kind, exp = step
+    n = len(frames)
+    errs = [f for f in frames if f.get("error")]
+    if errs:
+        return "PIPELINE ERROR", errs[0]["error"]
+    if kind in ("neutral", "head", "gaze", "phone", "persons") and n == 0:
+        return "PIPELINE ERROR", "no AI frame was analysed (camera not delivering frames?)"
+    faces = sum(1 for f in frames if (f["face"]["count"] or 0) >= 1)
+    if kind == "neutral":
+        calib = frames[-1]["face"]["calibration"]
+        cs = frames[-1]["face"]["calib_stats"] or {}
+        if faces < 0.5 * n:
+            return "NOT DETECTED", (f"face found in {faces}/{n} frames; reasons: "
+                                    + _most_common(r for f in frames for r in f["face"]["reasons"]))
+        txt = (f"face in {faces}/{n} frames; calibration={calib} after {cs.get('ready_after_s')} s "
+               f"({cs.get('method')}); accepted={cs.get('accepted')} rejected={cs.get('rejected')} "
+               f"resets={cs.get('resets')} last reject={cs.get('last_reject')}")
+        return ("DETECTED", txt) if calib == "ready" else ("SUPPRESSED", "calibration not ready: " + txt)
+
+    if kind in ("head", "gaze"):
+        ev = [e for e in events if e["event_type"].startswith("orientation_deviation")]
+        hit = [e for e in ev if f"({exp})" in e["description"]]
+        other = [e for e in ev if e not in hit]
+        if hit:
+            return "DETECTED", f"event '{hit[0]['description']}'"
+        if kind == "head":
+            seen = [f["head"]["direction"] for f in frames]
+            valid = sum(1 for f in frames if f["head"]["valid"])
+            run = _max_run(frames, lambda f: f["head"]["direction"] == HEAD_LABEL[exp])
+            ang = [(f["head"]["pitch"], f["head"]["yaw"]) for f in frames if f["head"]["valid"]]
+            extra = (f"; corrected pitch {min(a[0] for a in ang):+.0f}..{max(a[0] for a in ang):+.0f}, "
+                     f"yaw {min(a[1] for a in ang):+.0f}..{max(a[1] for a in ang):+.0f} deg "
+                     f"(limits: left/right 22, up 18, down 12)") if ang else ""
+        else:
+            seen = [f["gaze"]["direction"] for f in frames]
+            valid = sum(1 for f in frames if f["gaze"]["valid"])
+            run = _max_run(frames, lambda f: f["gaze"]["direction"] == GAZE_LABEL[exp])
+            closed = sum(1 for f in frames if f["gaze"]["eyes_closed"])
+            extra = (f"; eyes classified CLOSED in {closed}/{n} frames — looking down is indistinguishable from a "
+                     f"blink with the eye-lid geometry (known limitation)") if closed > n / 3 else ""
+        if other:
+            return "NOT DETECTED", (f"event in a DIFFERENT direction: '{other[0]['description']}' "
+                                    "(left/right swapped? old mirrored page still cached?)")
+        reasons = [s["reason"] for f in frames for s in f["signals"]
+                   if s["type"] == "orientation_deviation" and s["reason"]]
+        if valid == 0:
+            return "SUPPRESSED", ("never valid: " + (_most_common(reasons) or _most_common(
+                r for f in frames for r in f["face"]["reasons"])) + extra)
+        if run > 0:
+            return "SUPPRESSED", f"{exp} seen for max {run:.1f}s continuous; " + _most_common(reasons) + extra
+        return "NOT DETECTED", (f"direction never classified as {exp}; seen: {_most_common(seen, 3)}; "
+                                f"valid frames {valid}/{n}" + extra)
+
+    if kind == "phone":
+        conf = [e for e in events if e["event_type"] == "phone_detected"]
+        sus = [e for e in events if e["event_type"] == "phone_suspected"]
+        if conf:
+            return "DETECTED", f"event '{conf[0]['description']}'"
+        raw_frames = sum(1 for f in frames if f["phone"]["raw"])
+        stages = [f["phone"]["stage"] for f in frames]
+        best = max((d["conf"] for f in frames for d in f["phone"]["raw"]), default=0.0)
+        if sus:
+            return "SUPPRESSED", (f"only a SUSPECTED phone event (MONITOR tier); best detector confidence "
+                                  f"{best:.2f}; stages: {_most_common(stages)}")
+        if raw_frames == 0:
+            return "MODEL MISS", (f"YOLOv8m produced no cell-phone box in {n} frames (backend "
+                                  f"{frames[-1]['phone']['backend']}) — generic COCO model; fine-tuning required "
+                                  "if a phone was clearly visible")
+        return "SUPPRESSED", f"detector saw a phone in {raw_frames}/{n} frames (best {best:.2f}); stages: {_most_common(stages)}"
+
+    if kind == "persons":
+        ev = [e for e in events if e["event_type"] == "multiple_persons"]
+        if ev:
+            return "DETECTED", f"event '{ev[0]['description']}'"
+        mx = max((f["persons"] or 1) for f in frames)
+        if mx <= 1:
+            return "MODEL MISS", ("YOLO counted 1 person in every frame (a person must cover >= 10 % of the frame "
+                                  "and be detected with confidence >= 0.42)")
+        return "SUPPRESSED", f"2+ persons seen in some frames but no event (max {mx})"
+
+    if kind in ("speak", "silence"):
+        if ctx.get("audio_error"):
+            return "PIPELINE ERROR", "microphone/audio source failed: " + ctx["audio_error"]
+        if not audio:
+            return "PIPELINE ERROR", "no audio window reached the analyzer (microphone muted / wrong device?)"
+        backend = audio[-1]["backend"]
+        ev = [e for e in events if e["event_type"].startswith("audio_")]
+        top = _most_common(str((a.get("top_classes") or [["-"]])[0][0]) for a in audio)
+        sp = max(((a.get("group_scores") or {}).get("speech", 0.0) for a in audio), default=0.0)
+        rms = max((a.get("rms") or 0.0) for a in audio)
+        if kind == "silence":
+            if ev:
+                return "NOT DETECTED", f"FALSE audio event during silence: '{ev[0]['description']}' (top: {top})"
+            return "DETECTED", f"no audio event during silence (backend {backend}; top: {top}; max rms {rms:.4f})"
+        if ev:
+            return "DETECTED", f"event '{ev[0]['description']}' (backend {backend})"
+        if backend != "YAMNet":
+            return "PIPELINE ERROR", f"YAMNet not active (backend {backend}): {ctx.get('audio_status')}"
+        susp = sum(1 for a in audio if a.get("suspicious"))
+        if susp:
+            return "SUPPRESSED", f"{susp} suspicious window(s) but not confirmed: " + _most_common(a.get("reason") for a in audio)
+        return "NOT DETECTED", f"max speech score {sp:.2f} (threshold 0.45); top classes: {top}; max rms {rms:.4f}"
+    return "PIPELINE ERROR", "unknown step"
+
+
+# ── main ────────────────────────────────────────────────────────────────────
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--camera", type=int, default=0)
+    ap.add_argument("--video", default=None, help="replay a video file instead of the webcam")
