+    for k, v in env.items():
+        print(f"  {k:<14} {v}")
+    report = {"started": datetime.datetime.now().isoformat(timespec="seconds"), "environment": env, "steps": []}
+
+    import cv2
+    import numpy as np
+    from config import Config
+    from app import create_app
+    from extensions import db
+    from modules.detection import face_analyzer as fa_mod, phone_detector as pd_mod
+    print(f"  face models    {os.path.abspath(fa_mod.FACE_DETECTOR_MODEL)} / {os.path.abspath(fa_mod.FACE_LANDMARKER_MODEL)}")
+    print(f"  phone model    {os.path.abspath(pd_mod.YOLO_MODEL_PATH)} exists={os.path.isfile(pd_mod.YOLO_MODEL_PATH)}")
+
+    Diag = type("DiagConfig", (Config,), dict(
+        SQLALCHEMY_DATABASE_URI=os.environ["DATABASE_URL"], TESTING=True, WTF_CSRF_ENABLED=False,
+        AUDIO_WARMUP=False, AI_ASYNC=False,
+        VIOLATIONS_DIR=os.path.join(tmp, "violations"), RECORDINGS_DIR=os.path.join(tmp, "recordings")))
+    app = create_app(Diag)
+    with app.app_context():
+        from db_models import User, ExamRoom
+        p = User(username="diag_proctor", email="p@diag.local", role="proctor"); p.set_password("x" * 12)
+        s = User(username="diag_student", email="s@diag.local", role="student"); s.set_password("x" * 12)
+        db.session.add_all([p, s]); db.session.commit()
+        db.session.add(ExamRoom(id="DIAG01", name="live diag", proctor_id=p.id, status="active"))
+        db.session.commit()
+        sid = s.id
+    mgr = app.session_manager
+    session_id = mgr.start_session(sid, "diag_student", "DIAG01", role="student")
+    worker = mgr.get_worker(sid)
+    records = []
+    rlock = threading.Lock()
+
+    def hook(rec):
+        with rlock:
+            records.append(rec)
+    worker.diag_hook = hook
+
+    print("\nLoading models (first frame loads MediaPipe + YOLOv8m; YAMNet loads TensorFlow) ...", flush=True)
