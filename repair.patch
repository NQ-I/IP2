+"""
+benchmark/load_test_real_frames.py — N-student load test with REAL face frames and the
+page's REAL server-driven pacing (in-process; run it on the target server).
+
+    python benchmark/load_test_real_frames.py --levels 1 5 10 20 30 --duration 40
+
+Differences from benchmark/load_test_inprocess.py (which is kept unchanged):
+  * every student uploads a real face photo (matplotlib's bundled grace_hopper.jpg)
+    with a per-student colour mark, so MediaPipe does the full landmark / head-pose /
+    gaze work and the AI has to calibrate every student;
+  * upload rates follow the `pace` the server returns (core/pacing.py: <=10 students
+    preview 66 ms / AI 800 ms; 11-20: 100 / 1200 ms; >20: 150 / 2000 ms), exactly like
+    exam.html; audio = 1 s chunks of low noise (YAMNet runs, no speech);
+  * the proctor polls /proctor/streams every 250 ms and fetches a student's snapshot
+    whenever its frame_seq changed (what dashboard.html does);
+  * per level it reports, besides latencies / errors / CPU / RSS: AI frames per student
+    per second, the AI interval, how many students reached calibration "ready" and
+    after how long, and whether the interval still allows the temporal rules
+    (orientation 4 s, phone tracker: 2 observations inside 4 s).
+
+What is SIMULATED: the browsers (threads + Flask test client, no TCP/TLS, no camera).
+Detection ACCURACY is not measured.
+"""
+import argparse
+import json
+import os
+import platform
+import sys
+import tempfile
+import threading
+import time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+os.chdir(ROOT)
+
+import numpy as np                      # noqa: E402
+
+
+def pct(xs, p):
+    xs = sorted(xs)
+    return None if not xs else round(xs[min(len(xs) - 1, int(round(p * (len(xs) - 1))))], 1)
+
+
+def face_jpegs(i):
+    import cv2
+    import matplotlib
+    img = cv2.imread(os.path.join(os.path.dirname(matplotlib.__file__), "mpl-data", "sample_data", "grace_hopper.jpg"))
+    img = cv2.resize(img, (240, 280))
+    out = []
+    for k in range(3):                                   # tiny pose jitter between frames
+        can = np.full((240, 320, 3), 70, np.uint8)
+        dx = 40 + (k - 1) * 2
+        can[:, dx:dx + 240] = img[20:260]
+        colour = ((i * 53) % 256, (i * 97) % 256, (i * 151) % 256)
+        can[0:16, 0:16] = colour                          # per-student mark (isolation check)
+        out.append(cv2.imencode(".jpg", can, [cv2.IMWRITE_JPEG_QUALITY, 65])[1].tobytes())
+    return out, colour
+
+
+def run_level(app, n, duration, warmup, users, room):
+    import cv2
+    import psutil
+    from core.pacing import pacing
+    stop = threading.Event()
+    measuring = threading.Event()
+    lock = threading.Lock()
+    m = {"preview_ms": [], "ai_ms": [], "audio_ms": [], "snap_ms": [], "frame_age_ms": [],
+         "http5xx": 0, "http_other": 0, "wrong_frames": 0, "snaps": 0, "exceptions": []}
+    marks = {}
+    mgr = app.session_manager
+
+    def student(idx, uname):
+        try:
+            c = app.test_client()
+            c.post("/auth/login", data={"username": uname, "password": "Load-test-1"})
+            r = c.post("/student/session/start", json={"room_id": room})
+            if r.status_code != 200:
+                with lock:
+                    m["exceptions"].append(f"start {uname}: {r.status_code}")
+                return
+            frames, colour = face_jpegs(idx)
+            marks[uname] = colour
+            pace = dict(pacing(n))
+            nxt = {"preview": 0.0, "ai": 0.0, "audio": 0.0}
+            k = 0
+            rng = np.random.RandomState(idx)
+            while not stop.is_set():
+                now = time.time()
+                for ch, url in (("preview", "/student/frame_preview"), ("ai", "/student/frame")):
+                    if now >= nxt[ch]:
+                        t0 = time.perf_counter()
+                        r = c.post(url, data=frames[k % 3], headers={"Content-Type": "image/jpeg"})
+                        dt = (time.perf_counter() - t0) * 1000
+                        k += 1
+                        with lock:
+                            if r.status_code >= 500:
+                                m["http5xx"] += 1
+                            elif r.status_code >= 400:
+                                m["http_other"] += 1
+                            if measuring.is_set():
+                                m[f"{ch}_ms"].append(dt)
+                        try:
+                            pace.update(r.get_json().get("pace") or {})
+                        except Exception:                        # noqa: BLE001
+                            pass
+                        nxt[ch] = now + pace[f"{ch}_ms"] / 1000.0
+                if now >= nxt["audio"]:
+                    pcm = (rng.normal(0, 0.01, 16000) * 32767).astype("<i2").tobytes()
+                    t0 = time.perf_counter()
+                    r = c.post("/student/audio", data=pcm, headers={"Content-Type": "application/octet-stream",
+                                                                    "X-Sample-Rate": "16000"})
+                    with lock:
+                        if r.status_code >= 500:
+                            m["http5xx"] += 1
+                        if measuring.is_set():
+                            m["audio_ms"].append((time.perf_counter() - t0) * 1000)
+                    nxt["audio"] = now + pace["audio_ms"] / 1000.0
+                time.sleep(0.005)
+        except Exception as exc:                                 # noqa: BLE001
+            with lock:
+                m["exceptions"].append(f"{uname}: {type(exc).__name__}: {exc}")
+
+    def proctor():
+        c = app.test_client()
+        c.post("/auth/login", data={"username": "load_proctor", "password": "Load-test-1"})
+        seen = {}
+        while not stop.is_set():
+            r = c.get(f"/proctor/streams?room_id={room}")
+            if r.status_code >= 500:
+                with lock:
+                    m["http5xx"] += 1
+            data = (r.get_json() or {}).get("students", {}) if r.status_code == 200 else {}
+            for sid, st in data.items():
+                if st.get("frame_seq") and seen.get(sid) != st["frame_seq"]:
+                    seen[sid] = st["frame_seq"]
+                    t0 = time.perf_counter()
+                    s = c.get(f"/proctor/student/{sid}/snapshot?seq={st['frame_seq']}")
+                    dt = (time.perf_counter() - t0) * 1000
+                    if s.status_code == 200 and measuring.is_set():
+                        age = s.headers.get("X-Frame-Age-Ms")
+                        img = cv2.imdecode(np.frombuffer(s.data, np.uint8), cv2.IMREAD_COLOR)
+                        uname = users_by_id.get(int(sid))
+                        exp = marks.get(uname)
+                        ok = True
+                        if img is not None and exp is not None and s.headers.get("X-Frame-Source") == "live":
+                            got = img[4:12, 4:12].reshape(-1, 3).mean(axis=0)
+                            ok = float(np.abs(got - np.array(exp)).max()) < 40
+                        with lock:
+                            m["snap_ms"].append(dt)
+                            m["snaps"] += 1
+                            m["wrong_frames"] += 0 if ok else 1
+                            if age and age != "None":
+                                m["frame_age_ms"].append(float(age))
+            time.sleep(0.25)
+
+    users_by_id = {uid: name for name, uid in users[:n]}
+    threads = [threading.Thread(target=student, args=(i, name), daemon=True) for i, (name, _) in enumerate(users[:n])]
+    threads.append(threading.Thread(target=proctor, daemon=True))
+    proc = psutil.Process()
+    for t in threads:
+        t.start()
+    time.sleep(warmup)
+    workers = [mgr.get_worker(uid) for _, uid in users[:n]]
+    base = {id(w): (w.ai_frames_processed, w.ai_frames_received, w.ai_frames_replaced) for w in workers if w}
+    measuring.set()
+    proc.cpu_percent(None)
+    cpu, rss = [], []
+    t_end = time.time() + duration
+    while time.time() < t_end:
+        time.sleep(1)
+        cpu.append(proc.cpu_percent(None))
+        rss.append(proc.memory_info().rss / 2 ** 20)
+    measuring.clear()
+    stop.set()
+    for t in threads:
+        t.join(timeout=10)
+    workers = [mgr.get_worker(uid) for _, uid in users[:n]]
+    ai_rates, intervals, ready, ready_after, lat, qd = [], [], 0, [], [], []
+    received = processed = replaced = 0
+    for w in workers:
+        if not w:
+            continue
+        p0, r0, x0 = base.get(id(w), (0, 0, 0))
+        dp = w.ai_frames_processed - p0
+        processed += dp
+        received += w.ai_frames_received - r0
+        replaced += w.ai_frames_replaced - x0
+        ai_rates.append(dp / duration)
+        if dp:
+            intervals.append(duration / dp)
+        st = w._face_state or {}
+        cs = st.get("_calib_stats") or {}
+        if st.get("_calibrated"):
+            ready += 1
+            if cs.get("ready_after_s") is not None:
+                ready_after.append(cs["ready_after_s"])
+        lat.append(w.ai_latency.summary().get("p50") or 0)
+        qd.append(w.ai_queue_delay.summary().get("p50") or 0)
+    poll = app.test_client()
+    poll.post("/auth/login", data={"username": "load_proctor", "password": "Load-test-1"})
+    listed = len(poll.get(f"/proctor/students/poll?room_id={room}").get_json() or [])
+    med_int = pct(intervals, .5)
+    res = {
+        "students": n, "listed_in_poll": listed, "pace": pacing(n),
+        "http_5xx": m["http5xx"], "http_4xx": m["http_other"], "exceptions": m["exceptions"][:5],
+        "preview_post_ms_p50_p95": [pct(m["preview_ms"], .5), pct(m["preview_ms"], .95)],
+        "ai_post_ms_p50_p95": [pct(m["ai_ms"], .5), pct(m["ai_ms"], .95)],
+        "snapshot_get_ms_p50_p95": [pct(m["snap_ms"], .5), pct(m["snap_ms"], .95)],
+        "frame_age_ms_p50_p95": [pct(m["frame_age_ms"], .5), pct(m["frame_age_ms"], .95)],
+        "proctor_frames_per_student_per_s": round(m["snaps"] / duration / max(1, n), 2),
+        "wrong_student_frames": m["wrong_frames"],
+        "ai_fps_per_student_median": pct(ai_rates, .5), "ai_fps_per_student_min": pct(ai_rates, 0),
+        "ai_interval_s_median": med_int,
+        "ai_frames_received_processed_replaced": [received, processed, replaced],
+        "ai_processing_ms_p50_median_over_students": pct(lat, .5),
+        "ai_queue_delay_ms_p50_median_over_students": pct(qd, .5),
+        "calibrated": f"{ready}/{n}", "calibration_ready_after_s_median": pct(ready_after, .5),
+        "orientation_4s_rule_feasible": bool(med_int and med_int <= 2.0),
+        "phone_2obs_in_4s_feasible": bool(med_int and med_int <= 2.0),
+        "cpu_percent_avg_max": [round(float(np.mean(cpu)), 1), round(float(np.max(cpu)), 1)] if cpu else None,
+        "rss_mb_max": round(max(rss), 1) if rss else None,
+    }
+    for _, uid in users[:n]:
+        mgr.stop_session(uid)
+    return res
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--levels", type=int, nargs="+", default=[1, 5, 10, 20, 30])
+    ap.add_argument("--duration", type=float, default=40)
+    ap.add_argument("--warmup", type=float, default=15)
+    ap.add_argument("--out", default="reports/load_test_real_frames.json")
+    a = ap.parse_args()
+    tmp = tempfile.mkdtemp(prefix="loadrf_")
+    os.environ["DATABASE_URL"] = "sqlite:///" + os.path.join(tmp, "load.db").replace("\\", "/")
+    from config import Config
+    from app import create_app
+    from extensions import db
+    cfg = type("LoadConfig", (Config,), dict(SQLALCHEMY_DATABASE_URI=os.environ["DATABASE_URL"],
+                                            WTF_CSRF_ENABLED=False, VIOLATIONS_DIR=os.path.join(tmp, "v"),
+                                            RECORDINGS_DIR=os.path.join(tmp, "r")))
+    app = create_app(cfg)
+    mx = max(a.levels)
+    with app.app_context():
+        from db_models import User, ExamRoom
+        p = User(username="load_proctor", email="lp@x.local", role="proctor"); p.set_password("Load-test-1")
+        db.session.add(p)
+        for i in range(mx):
+            u = User(username=f"load_s{i}", email=f"ls{i}@x.local", role="student"); u.set_password("Load-test-1")
+            db.session.add(u)
+        db.session.commit()
+        db.session.add(ExamRoom(id="LOAD01", name="load", proctor_id=p.id, status="active")); db.session.commit()
+        users = [(u.username, u.id) for u in User.query.filter(User.role == "student").order_by(User.id).all()]
+    from core.detector_pool import get_shared_pool
+    t0 = time.time()
+    pool = get_shared_pool()
+    print(f"detector pool: {pool.size} pair(s), loaded in {time.time() - t0:.1f}s; "
+          f"phone backend {pool._pairs.queue[0][1].backend}; cpus {os.cpu_count()}", flush=True)
+    app.audio_pipeline.warmup()
+    out = {"machine": {"platform": platform.platform(), "cpus": os.cpu_count(), "python": platform.python_version(),
+                       "pool_size": pool.size}, "levels": []}
+    for n in a.levels:
+        print(f"\n=== {n} student(s): warm-up {a.warmup}s, measuring {a.duration}s", flush=True)
+        r = run_level(app, n, a.duration, a.warmup, users, "LOAD01")
+        out["levels"].append(r)
+        print(json.dumps(r, indent=1), flush=True)
+    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
+    with open(a.out, "w") as f:
+        json.dump(out, f, indent=1)
+    print("written", os.path.abspath(a.out))
+
+
+if __name__ == "__main__":
+    main()
