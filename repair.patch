+        print(f"  audio backend  {audio_status.get('backend')}  load_error={audio_status.get('load_error')}  "
+              f"tf={audio_status.get('tf_version')}  model={audio_status.get('model_dir')}")
+    report["audio_status"] = audio_status
+
+    src = LatestFrame(a.camera, a.video)
