+"""
+core/diag.py — PROCTOR_DIAG=1 diagnostic mode (off by default).
+
+    Windows PowerShell:   $env:PROCTOR_DIAG = "1"; python run.py
+    Linux/macOS:          PROCTOR_DIAG=1 python run.py
+
+Optional: PROCTOR_DIAG_FILE=diag.jsonl also appends every record as one JSON line.
+
+When enabled, every analysed AI frame of every student produces ONE structured
+console line (logger "proctor_diag") with what the spec asks to see: student /
+session, frame seq, AI fps, preview fps, face status + reasons, calibration,
+raw / neutral / corrected pitch-yaw, head direction, raw / neutral gaze, gaze
+direction, orientation state / duration, phone stage, current / cumulative risk,
+last emitted event, stream state, and for every signal: emitted or the
+suppression reason.  Audio windows get their own line (backend, top classes,
+speech score, decision).  When disabled nothing is computed or printed.
+
+Thread-safety: records are built from values owned by the calling worker and
+written through `logging` (thread-safe); the JSONL file is written under a lock.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import threading
+import time
+
+ENABLED = os.environ.get("PROCTOR_DIAG", "0") == "1"
+_FILE = os.environ.get("PROCTOR_DIAG_FILE") or None
+_lock = threading.Lock()
+log = logging.getLogger("proctor_diag")
+
+
+def enabled() -> bool:
+    return ENABLED
+
+
+def _fmt(v, nd=1):
+    return "-" if v is None else (f"{v:+.{nd}f}" if isinstance(v, float) else str(v))
+
+
+def _write(rec: dict):
+    if not _FILE:
+        return
+    try:
+        from core.json_safe import to_json_safe
+        with _lock, open(_FILE, "a", encoding="utf-8") as f:
+            f.write(json.dumps(to_json_safe(rec)) + "\n")
+    except Exception:                                    # noqa: BLE001
+        pass
+
+
+def frame_record(worker, face: dict, phone: dict, signals: list, risk_now: float,
+                 cumulative: float, frame_shape) -> dict:
+    """Build + emit the per-frame record.  `signals` = [(etype, active, emitted, reason)]."""
+    st = worker.get_stream_status()
+    trace = phone.get("phone_trace") or {}
+    raw = trace.get("raw") or []
+    cs = face.get("calibration_stats") or {}
+    last = worker.events.events(limit=1)
+    rec = {
+        "ts": round(time.time(), 3), "kind": "frame",
+        "student": worker.student_name, "student_id": worker.student_id,
+        "session": worker.session_id[:8], "frame_seq": worker.ai_frames_processed + 1,
+        "input": list(frame_shape[:2][::-1]),
+        "ai_fps": st["ai"]["fps"], "preview_fps": st["preview"]["fps"], "stream": st["state"],
+        "face": {"count": face.get("face_count"), "quality": face.get("quality_state"),
+                 "reasons": list(dict.fromkeys(face.get("quality_reasons") or [])),
+                 "detector_scores": face.get("face_detector_scores"),
+                 "boxes": face.get("face_boxes"), "area_pct": None if face.get("face_area_fraction") is None
+                 else round(100 * float(face.get("face_area_fraction")), 1),
+                 "brightness": face.get("brightness"), "blur": face.get("blur_score"),
+                 "landmarks": face.get("landmark_count"),
+                 "calibration": face.get("calibration_state"), "calib_stats": cs},
+        "head": {"pitch_raw": face.get("head_pitch_raw"), "yaw_raw": face.get("head_yaw_raw"),
+                 "neutral_pitch": face.get("neutral_pitch"), "neutral_yaw": face.get("neutral_yaw"),
+                 "pitch": face.get("head_pitch"), "yaw": face.get("head_yaw"),
+                 "valid": face.get("head_pose_valid"), "direction": face.get("head_warning"),
+                 "quality": face.get("head_quality")},
+        "gaze": {"x_raw": face.get("gaze_x_raw"), "y_raw": face.get("gaze_y_raw"),
+                 "neutral_x": face.get("neutral_gaze_x"), "neutral_y": face.get("neutral_gaze_y"),
+                 "deviation": face.get("deviation_from_neutral"),
+                 "valid": face.get("gaze_valid"), "confidence": face.get("gaze_confidence"),
+                 "direction": face.get("gaze"), "eyes_closed": face.get("eyes_closed")},
+        "orientation": {"state": face.get("orientation_state"),
+                        "direction": face.get("orientation_direction"),
+                        "duration": face.get("orientation_duration"),
+                        "confidence": face.get("orientation_confidence")},
+        "phone": {"backend": phone.get("backend"), "stage": trace.get("stage"),
+                  "tier": trace.get("tier"), "raw": raw, "tracks": trace.get("tracks"),
+                  "ms": (phone.get("phone_timing") or {}).get("total_ms")},
+        "persons": phone.get("person_count"),
+        "risk": {"current": round(risk_now, 3), "cumulative": round(cumulative, 3)},
+        "signals": [{"type": t, "active": a, "emitted": e, "reason": r} for t, a, e, r in signals],
+        "last_event": (last[-1]["event_type"] + f"#{last[-1]['seq']}") if last else None,
+    }
+    if ENABLED:
+        h, o, p = rec["head"], rec["orientation"], rec["phone"]
+        best = max(raw, key=lambda d: d["conf"], default=None)
+        sig = "; ".join(f"{t}: {'EMITTED' if e else ('active' if a else '-')}{(' — ' + r) if r else ''}"
+                        for t, a, e, r in signals if a or e or r)
+        log.info(
+            "[DIAG %s s=%s #%d] stream=%s ai=%.2ffps prev=%.1ffps | face n=%s score=%s area=%s%% light=%s "
+            "lm=%s q=%s %s calib=%s(acc=%s rej=%s last=%s) "
+            "| head raw(p=%s y=%s) neutral(p=%s y=%s) corr(p=%s y=%s) valid=%s dir=%s "
+            "| gaze raw(x=%s y=%s) neutral(x=%s y=%s) valid=%s conf=%.2f dir=%s "
+            "| orient=%s/%s %.1fs conf=%.2f | phone=%s best=%s | persons=%s | risk now=%.0f%% cum=%.0f%% last=%s | %s",
+            rec["student"], rec["session"], rec["frame_seq"], rec["stream"], rec["ai_fps"] or 0.0,
+            rec["preview_fps"] or 0.0, rec["face"]["count"], rec["face"]["detector_scores"],
+            rec["face"]["area_pct"], None if rec["face"]["brightness"] is None else round(rec["face"]["brightness"]),
+            rec["face"]["landmarks"], rec["face"]["quality"],
+            ",".join(rec["face"]["reasons"]) or "-", rec["face"]["calibration"], cs.get("accepted"),
+            cs.get("rejected"), cs.get("last_reject"),
+            _fmt(h["pitch_raw"]), _fmt(h["yaw_raw"]), _fmt(h["neutral_pitch"]), _fmt(h["neutral_yaw"]),
+            _fmt(h["pitch"]), _fmt(h["yaw"]), h["valid"], h["direction"],
+            _fmt(rec["gaze"]["x_raw"], 2), _fmt(rec["gaze"]["y_raw"], 2), _fmt(rec["gaze"]["neutral_x"], 2),
+            _fmt(rec["gaze"]["neutral_y"], 2), rec["gaze"]["valid"], rec["gaze"]["confidence"] or 0.0,
+            rec["gaze"]["direction"], o["state"], o["direction"], o["duration"] or 0.0, o["confidence"] or 0.0,
+            p["stage"], (f"{best['conf']:.2f}/{best['decision']}" if best else "-"), rec["persons"],
+            risk_now * 100, cumulative * 100, rec["last_event"], sig or "no signal active")
+        _write(rec)
+    return rec
+
+
+def audio_record(worker, result: dict, confirm_hits: int, needed: int, emitted: bool, reason: str):
+    rec = {"ts": round(time.time(), 3), "kind": "audio", "student": worker.student_name,
+           "session": worker.session_id[:8], "backend": result.get("backend"),
+           "event": result.get("event"), "confidence": result.get("confidence"),
+           "suspicious": result.get("is_suspicious"), "rms": result.get("audio_level"),
+           "inference_ran": result.get("inference_ran"), "decision": result.get("decision"),
+           "group_scores": result.get("group_scores"), "top_classes": result.get("top_classes"),
+           "infer_ms": result.get("infer_ms"), "confirm_hits": confirm_hits, "needed": needed,
+           "emitted": emitted, "reason": reason}
+    if ENABLED:
+        g = result.get("group_scores") or {}
+        log.info("[DIAG-AUDIO %s s=%s] backend=%s inference=%s rms=%s event=%s conf=%s speech=%s whisper=%s "
+                 "shout=%s top=%s | hits %d/%d -> %s%s",
+                 rec["student"], rec["session"], rec["backend"], rec["inference_ran"], rec["rms"],
+                 rec["event"], rec["confidence"], g.get("speech"), g.get("whispering"), g.get("shout"),
+                 rec["top_classes"], confirm_hits, needed, "EMITTED" if emitted else "not emitted",
+                 (" — " + reason) if reason else "")
+        _write(rec)
+    return rec
