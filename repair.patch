+"""
+REAL-media checks of the repaired detection paths (real MediaPipe, real YOLOv8m,
+real YAMNet).  Inputs are third-party public media downloaded by
+`python tools/fetch_test_assets.py` into tests/assets/; when they are missing the
+tests are SKIPPED (reported as not verified), never passed.
+
+These prove the code paths on real landmarks / real detector outputs.  They are
+not accuracy measurements and they do not replace the webcam test
+(tools/live_diag.py).
+"""
+import os
+
+import cv2
+import numpy as np
+import pytest
+
+from tests import helpers as H
+
+A = os.path.join(H.ROOT, "tests", "assets")
+pytestmark = pytest.mark.real_models
+
+
+def _need(*names):
+    missing = [n for n in names if not os.path.isfile(os.path.join(A, n))]
+    if missing:
+        pytest.skip("NOT VERIFIED - test asset missing (run tools/fetch_test_assets.py): " + ", ".join(missing))
+
+
+def _gif_frames(name):
+    from PIL import Image, ImageSequence
+    im = Image.open(os.path.join(A, name))
+    return [cv2.cvtColor(np.array(f.convert("RGB")), cv2.COLOR_RGB2BGR) for f in ImageSequence.Iterator(im)]
+
+
+@pytest.fixture(scope="module")
+def _fa():
+    """ONE real FaceAnalyzer for the module, closed explicitly (MediaPipe 1.x can deadlock when a
+    detector is garbage-collected while another one is running)."""
+    from modules.detection.face_analyzer import FaceAnalyzer
+    fa = FaceAnalyzer()
+    yield fa
+    fa.close()
+
+
+@pytest.fixture
+def sim_analyzer(monkeypatch, _fa):
+    """Real FaceAnalyzer with a simulated monotonic clock (1.25 AI fps like the exam page)."""
+    from modules.detection import face_analyzer as F
+    clock = [1000.0]
+    monkeypatch.setattr(F.time, "monotonic", lambda: clock[0])
+    fa = _fa
+    fa.set_state(None)
+
+    def run(frames, step=0.8, all_results=False):
+        out = []
+        for fr in frames:
+            out.append(fa.analyze(fr))
+            clock[0] += step
+        return out if all_results else out[-1]
+    return fa, run
+
+
+def _turn_frames(flip=False):
+    fr = _gif_frames("headturn_out.gif")
+    crop = lambda i: fr[i][20:260, 200:520]                       # 320x240 around the speaker
+    neutral = [crop(230)] * 63                                    # ~50 s, calibration
+    turn = [crop(i) for i in (221, 222, 223, 224, 122, 218)] * 2  # yaw -37..-56 deg, ~9.6 s
+    if flip:
+        neutral = [cv2.flip(f, 1) for f in neutral]
+        turn = [cv2.flip(f, 1) for f in turn]
+    return neutral, turn
+
+
+def test_real_large_head_turn_to_the_left_is_a_sustained_head_left(sim_analyzer):
+    """BEFORE: frames with yaw -40..-56 deg were 'poor' (excessive_head_angle) -> no head direction."""
+    _need("headturn_out.gif")
+    fa, run = sim_analyzer
+    neutral, turn = _turn_frames()
+    assert run(neutral)["calibration_state"] == "ready"
+    res = run(turn)
+    assert res["head_pose_valid"] and res["head_warning"] == "Head Left"
+    assert res["orientation_state"] == "head_deviation" and res["orientation_direction"] == "left"
+    assert res["orientation_duration"] >= 4.0 and res["orientation_confidence"] >= 0.5
+
+
+def test_real_mirrored_frames_swap_left_and_right(sim_analyzer):
+    """What the original exam page uploaded: a mirrored frame turns the same LEFT turn into RIGHT."""
+    _need("headturn_out.gif")
+    fa, run = sim_analyzer
+    neutral, turn = _turn_frames(flip=True)
+    run(neutral)
+    warnings = [r["head_warning"] for r in run(turn, all_results=True)]
+    assert warnings.count("Head Right") >= len(warnings) // 2 and "Head Left" not in warnings, warnings
+
+
+def test_real_head_up(sim_analyzer):
+    _need("headpose_webcam.gif")
+    fa, run = sim_analyzer
+    fr = [cv2.resize(f[0:270, 60:420], (320, 240)) for f in _gif_frames("headpose_webcam.gif")]
+    neutral = [fr[i] for i in (0, 3, 6, 9, 12, 15)] * 10
+    run(neutral)
+    res = run([fr[i] for i in (276, 278, 280, 282)] * 2)
+    assert res["head_warning"] == "Head Up" and res["orientation_duration"] >= 4.0
+
+
+@pytest.mark.parametrize("img,direction", [("face_img4.jpg", "Looking Left"), ("face_img1.jpg", "Looking Right")])
+def test_real_iris_gaze_left_right(sim_analyzer, img, direction):
+    _need("face_img10.jpg", img)
+    fa, run = sim_analyzer
+    base = cv2.imread(os.path.join(A, "face_img10.jpg"))
+    run([base] * 20)
+    res = run([cv2.imread(os.path.join(A, img))] * 8)
+    assert res["gaze_valid"] and res["gaze"] == direction
+    assert res["orientation_state"] in ("eye_deviation", "combined_deviation") and res["orientation_duration"] >= 4.0
+
+
+def test_real_downcast_eyes_are_classified_as_closed_known_limitation(sim_analyzer):
+    """Documents a KNOWN LIMITATION (report §10): eyes looking down are classified as a blink
+    by the eye-lid geometry, so 'Eyes Down' is not produced from these real frames."""
+    _need("headpose_demo.gif")
+    fa, run = sim_analyzer
+    fr = _gif_frames("headpose_demo.gif")
+    closed = 0
+    for i in (4, 5, 6, 7, 9, 10, 11):
+        res = fa.analyze(fr[i])
+        closed += bool(res["eyes_closed"]) or res["gaze"] in ("Eyes Closed", "Unknown")
+    assert closed >= 5
+
+
+_PD = []
+
+
+def _phone_tiers(img, frames=4):
+    from modules.detection.phone_detector import PhoneDetector
+    if not _PD:
+        _PD.append(PhoneDetector())          # one detector for the module
+    pd = _PD[0]
+    pd.set_state(None)
+    h, w = img.shape[:2]
+    if w / h > 4 / 3:                                                    # a webcam frame is 4:3
+        nw = int(h * 4 / 3); img = img[:, (w - nw) // 2:(w - nw) // 2 + nw]
+    small = cv2.resize(img, (320, 240), interpolation=cv2.INTER_AREA)   # exam page AI frame size
+    small = cv2.imdecode(cv2.imencode(".jpg", small, [cv2.IMWRITE_JPEG_QUALITY, 65])[1], cv2.IMREAD_COLOR)
+    tiers = []
+    for i in range(frames):
+        r = pd.detect(np.clip(small.astype(np.int16) + (i % 3) - 1, 0, 255).astype(np.uint8))
+        tiers.append(r["phone_trace"]["tier"])
+    return tiers, r
+
+
+def test_real_phone_is_traced_to_the_stage_that_stops_it():
+    """Real phone (COCO 536) at the exam's 320x240: YOLOv8m boxes it in most frames, and the trace
+    names the stage that decides. Today that is the tracker's confidence-weighted gate: a
+    documented MODEL LIMITATION (report §11), not a crash and not a silent NONE."""
+    _need("phone_coco_536.jpg")
+    tiers, r = _phone_tiers(cv2.imread(os.path.join(A, "phone_coco_536.jpg")), frames=6)
+    assert r["phone_trace"]["raw"], r["phone_trace"]
+    assert r["phone_trace"]["stage"].startswith(("TRACKER GATE", "ENSEMBLE", "CONFIRMED")), (tiers, r["phone_trace"])
+
+
+def test_real_phone_free_photos_never_confirm_a_phone():
+    """Guards the phone operating point. Phone-free faces give NONE. A statuette base, dark fabric
+    and a hand-held microphone must never be CONFIRMED (+70 cumulative): a presence-based tracker
+    buffer that was tried confirmed two of them (report §11)."""
+    _need("face_img10.jpg", "face_img30.jpg", "face_img37.jpg", "face_img54.jpg", "face_img59.jpg")
+    for n in ("face_img10.jpg", "face_img30.jpg"):
+        tiers, r = _phone_tiers(cv2.imread(os.path.join(A, n)))
+        assert set(tiers) == {"NONE"}, (n, tiers, r["phone_trace"])
+    for n in ("face_img37.jpg", "face_img54.jpg", "face_img59.jpg"):
+        tiers, r = _phone_tiers(cv2.imread(os.path.join(A, n)), frames=6)
+        assert "CONFIRMED" not in tiers, (n, tiers, r["phone_trace"])
+
+
+def test_real_yamnet_speech_becomes_an_event_typing_does_not(app, stub_pool):
+    _need("speech_jfk.flac", "esc50_keyboard_typing.wav")
+    import soundfile as sf
+    from core.audio_pipeline import AudioPipeline
+    from modules.detection.audio_analyzer import get_shared_analyzer
+    an = get_shared_analyzer()
+    if an.backend != "YAMNet":
+        pytest.skip("NOT VERIFIED - YAMNet not loaded: " + str(an.load_error))
+    pid, _ = H.add_user(app, role="proctor"); room = H.add_room(app, pid)
+    results = {}
+    for name in ("esc50_keyboard_typing.wav", "speech_jfk.flac"):
+        sid, sname = H.add_user(app)
+        app.session_manager.start_session(sid, sname, room)
+        w = app.session_manager.get_worker(sid)
+        pipe = AudioPipeline(app.session_manager.get_worker)
+        x, sr = sf.read(os.path.join(A, name), dtype="float32", always_2d=True)
+        x = x.mean(axis=1)
+        for i in range(0, min(x.size, 6 * sr) - sr + 1, sr):          # 1 s chunks like the browser
+            pipe.submit(sid, x[i:i + sr], sr)
+            pipe.wait_idle(10)
+        results[name] = w.get_status()
+    assert "audio_speech" in results["speech_jfk.flac"]["events_by_type"]
+    assert results["speech_jfk.flac"]["cumulative_risk"] >= 0.2
+    assert not any(t.startswith("audio_") for t in results["esc50_keyboard_typing.wav"]["events_by_type"])
