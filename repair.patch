+++ b/core/json_safe.py
@@ -0,0 +1,86 @@
+"""
+core/json_safe.py — keep NumPy values out of every JSON response.
+
+Root cause this guards against (reproduced on this project, see
+FINAL_REAL_RUNTIME_REPAIR_REPORT.md §3-§5): FaceAnalyzer.analyze() returned
+``eyes_closed`` as ``numpy.bool_`` (a comparison against a NumPy float).  The
+worker copied it into the student status, and ``jsonify()`` raised
+``TypeError: Object of type bool_ is not JSON serializable`` -> HTTP 500 on
+``POST /student/frame`` and on ``GET /proctor/students/poll`` (empty dashboard).
+
+``numpy.bool_``/``numpy.int64``/``numpy.float32`` are NOT subclasses of Python
+``bool``/``int``/``float`` (``numpy.float64`` happens to be), so any detector
+value can break serialization.  Two helpers:
+
+  find_unsafe(obj)   -> [(json_path, type_name, repr)] for every value that the
+                        standard ``json`` module cannot encode (diagnostics,
+                        tests, PROCTOR_DIAG).
+  to_json_safe(obj)  -> the same structure with NumPy scalars converted to the
+                        matching Python type (bool / int / float) and arrays to
+                        lists.  Nothing is converted to a string.
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+_NATIVE = (str, int, float, bool, type(None))
+
+
+def _type_name(v) -> str:
+    t = type(v)
+    return f"{t.__module__}.{t.__name__}" if t.__module__ != "builtins" else t.__name__
+
+
+def find_unsafe(obj, path: str = "$", out: list | None = None) -> list:
+    """Every non-JSON-native leaf as (json_path, type, repr).  Exact types are
+    checked (``type(v) in ...``), so numpy.float64 — which json *can* encode
+    because it subclasses float — is still reported as a NumPy leak."""
+    out = [] if out is None else out
+    if isinstance(obj, dict):
+        for k, v in obj.items():
+            if type(k) not in _NATIVE:
+                out.append((f"{path}.<key {k!r}>", _type_name(k), repr(k)[:80]))
+            audit_key = k if isinstance(k, str) else repr(k)
+            find_unsafe(v, f"{path}.{audit_key}", out)
+    elif isinstance(obj, (list, tuple)):
+        for i, v in enumerate(obj):
+            find_unsafe(v, f"{path}[{i}]", out)
+    elif type(obj) not in _NATIVE:
+        out.append((path, _type_name(obj), repr(obj)[:80]))
+    return out
+
+
+def describe_unsafe(obj, root: str = "$") -> str:
+    """Human-readable report, one line per unsafe value ('' when clean)."""
+    return "\n".join(f"[json-audit] {p} -> {t} = {v}" for p, t, v in find_unsafe(obj, root))
+
+
+def to_json_safe(obj):
+    """Recursively convert NumPy scalars/arrays to plain Python values.
+    np.bool_ -> bool, np.integer -> int, np.floating -> float (NaN/inf -> None,
+    which is what JSON can represent), np.ndarray -> list.  Tuples become lists
+    (JSON has no tuples).  Anything else is returned unchanged."""
+    if isinstance(obj, dict):
+        return {(k if type(k) in _NATIVE else to_json_safe(k)): to_json_safe(v)
+                for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [to_json_safe(v) for v in obj]
+    t = type(obj)
+    if t in _NATIVE:
+        if t is float and not math.isfinite(obj):
+            return None
+        return obj
+    if isinstance(obj, np.bool_):
+        return bool(obj)
+    if isinstance(obj, np.integer):
+        return int(obj)
+    if isinstance(obj, np.floating):
+        f = float(obj)
+        return f if math.isfinite(f) else None
+    if isinstance(obj, np.ndarray):
+        return to_json_safe(obj.tolist())
+    if isinstance(obj, np.generic):          # any other NumPy scalar
+        return to_json_safe(obj.item())
+    return obj
