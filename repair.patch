+"""
+Regression tests for the runtime repairs described in FINAL_REAL_RUNTIME_REPAIR_REPORT.md.
+
+Each test names the defect it guards against.  Real MediaPipe is used where the
+defect lived in real detector output (NumPy bool from FaceAnalyzer); test doubles
+(tests/helpers.py) are used for the event / risk / session logic.
+"""
+import datetime
+import json
+import os
+import time
+
+import cv2
+import matplotlib
+import numpy as np
+import pytest
+
+from tests import helpers as H
+from core import risk as R
+from core.json_safe import find_unsafe, to_json_safe
+
+PHOTO = os.path.join(os.path.dirname(matplotlib.__file__), "mpl-data", "sample_data", "grace_hopper.jpg")
+
+
+def _jpeg(img, w=320, h=240, q=65):
+    ok, buf = cv2.imencode(".jpg", cv2.resize(img, (w, h), interpolation=cv2.INTER_AREA),
+                           [cv2.IMWRITE_JPEG_QUALITY, q])
+    assert ok
+    return buf.tobytes()
+
+
+def _world(app):
+    pid, pname = H.add_user(app, role="proctor")
+    room = H.add_room(app, pid)
+    sid, sname = H.add_user(app)
+    return {"pid": pid, "pname": pname, "room": room, "sid": sid, "sname": sname}
+
+
+def _client(app, username):
+    return H.login(app.test_client(), username)
+
+
+# ── 1. NumPy values can never reach a JSON response ──────────────────────────
+def test_numpy_bool_int_float_are_found_and_converted():
+    obj = {"a": np.bool_(True), "b": [np.int64(3), {"c": np.float32(0.5)}],
+           "d": np.array([1, 2]), "e": np.float64(1.5), "f": float("nan"), "ok": [1, "x", None, False]}
+    found = {p for p, _, _ in find_unsafe(obj)}
+    assert found == {"$.a", "$.b[0]", "$.b[1].c", "$.d", "$.e"}
+    safe = to_json_safe(obj)
+    assert find_unsafe(safe) == []
+    json.dumps(safe, allow_nan=False)                     # strict JSON, no NaN
+    assert safe["a"] is True and type(safe["b"][0]) is int and safe["b"][1]["c"] == 0.5
+    assert safe["d"] == [1, 2] and safe["e"] == 1.5 and safe["f"] is None
+
+
+@pytest.fixture(scope="module")
+def analyzer():
+    """ONE real FaceAnalyzer per module, closed explicitly.  (With MediaPipe 1.x a detector
+    garbage-collected while another detector is running can deadlock inside __del__.)"""
+    from modules.detection.face_analyzer import FaceAnalyzer
+    fa = FaceAnalyzer()
+    yield fa
+    fa.close()
+
+
+def test_real_face_analyzer_output_is_plain_python(analyzer):
+    """BEFORE: eyes_closed was numpy.bool_ for every frame with a face -> HTTP 500."""
+    fa = analyzer
+    fa.set_state(None)
+    res = fa.analyze(cv2.resize(cv2.imread(PHOTO), (320, 240)))
+    assert res["face_count"] == 1
+    assert type(res["eyes_closed"]) is bool
+    assert find_unsafe(res) == []
+
+
+class _RealFacePool:
+    """Real MediaPipe FaceAnalyzer + test-double phone detector."""
+    def __init__(self, fa):
+        fa.set_state(None)
+        self.pair = (fa, H.StubPhone())
+
+    def acquire(self, timeout=30):
+        return self.pair
+
+    def release(self, pair):
+        pass
+
+
+def test_frame_and_poll_never_500_with_a_real_face(app, monkeypatch, analyzer):
+    """BEFORE: POST /student/frame 200,200,500,500... and GET /proctor/students/poll 500
+    (dashboard '0 Active') as soon as the AI had analysed one frame with a face."""
+    import core.student_worker as sw
+    pool = _RealFacePool(analyzer)
+    monkeypatch.setattr(sw, "get_shared_pool", lambda: pool)
+    w = _world(app)
+    stu, pro = _client(app, w["sname"]), _client(app, w["pname"])
+    assert stu.post("/student/session/start", json={"room_id": w["room"]}).status_code == 200
+    face = _jpeg(cv2.imread(PHOTO))
+    worker = app.session_manager.get_worker(w["sid"])
+    codes = []
+    for _ in range(5):
+        r = stu.post("/student/frame", data=face, headers={"Content-Type": "image/jpeg"})
+        codes.append(r.status_code)
+        end = time.time() + 30
+        while worker.has_pending_ai() and time.time() < end:
+            time.sleep(0.05)
+    r = stu.post("/student/frame", data=face, headers={"Content-Type": "image/jpeg"})
+    codes.append(r.status_code)
+    assert codes == [200] * 6, codes
+    assert worker.ai_frames_processed >= 3 and worker.get_status()["face_count"] == 1
+    assert type(r.get_json()["eyes_closed"]) is bool
+    poll = pro.get("/proctor/students/poll")
+    assert poll.status_code == 200
+    assert [s["student_id"] for s in poll.get_json()] == [w["sid"]]          # active student appears
+    assert find_unsafe(worker.get_status()) == []
+    assert pro.get(f"/proctor/student/{w['sid']}/status").status_code == 200
+
+
+# ── 2. Roles / ownership ──────────────────────────────────────────────────────
+def test_only_students_and_explicit_admin_tests_take_exams(app, stub_pool):
+    """BEFORE: any proctor could POST /student/session/start and appear as a 'student'."""
+    w = _world(app)
+    aid, aname = H.add_user(app, role="admin")
+    p2, p2name = H.add_user(app, role="proctor")
+    mgr = app.session_manager
+    for name, uid in ((w["pname"], w["pid"]), (p2name, p2)):
+        c = _client(app, name)
+        r = c.post("/student/session/start", json={"room_id": w["room"]})
+        assert r.status_code == 403 and r.get_json()["code"] == "role_not_allowed"
+        assert c.post("/student/frame_preview", data=H.synth_jpeg(1),
+                      headers={"Content-Type": "image/jpeg"}).status_code == 403
+        assert mgr.get_worker(uid) is None
+        assert c.get("/exam").status_code == 302                       # sent to the dashboard
+    s = _client(app, w["sname"])
+    assert s.post("/student/session/start", json={"room_id": w["room"]}).status_code == 200
+    st = mgr.get_student_status(w["sid"])
+    assert st["session_role"] == "student" and st["test_session"] is False
+    a = _client(app, aname)
+    r = a.post("/student/session/start", json={"room_id": w["room"]})
+    assert r.status_code == 200 and r.get_json()["test_session"] is True
+    assert mgr.get_student_status(aid)["test_session"] is True          # explicit, visible
+    pro = _client(app, w["pname"])
+    ids = {x["student_id"]: x for x in pro.get("/proctor/students/poll").get_json()}
+    assert set(ids) == {w["sid"], aid} and ids[aid]["test_session"] is True
+
+
+def test_poll_is_scoped_to_the_proctors_rooms(app, stub_pool):
+    w = _world(app)
+    other, oname = H.add_user(app, role="proctor")
+    s = _client(app, w["sname"])
+    s.post("/student/session/start", json={"room_id": w["room"]})
+    s.post("/student/frame_preview", data=H.synth_jpeg(1), headers={"Content-Type": "image/jpeg"})
+    own = _client(app, w["pname"]).get("/proctor/students/poll")
+    assert own.status_code == 200 and [x["student_id"] for x in own.get_json()] == [w["sid"]]
+    foreign = _client(app, oname)
+    assert foreign.get("/proctor/students/poll").get_json() == []
+    assert foreign.get(f"/proctor/students/poll?room_id={w['room']}").status_code == 403
+    assert foreign.get(f"/proctor/student/{w['sid']}/snapshot").status_code == 403
+
+
+# ── 3. Live video ─────────────────────────────────────────────────────────────
+def test_preview_latest_frame_wins_and_snapshot_serves_the_newest(app, stub_pool):
+    w = _world(app)
+    s = _client(app, w["sname"])
+    s.post("/student/session/start", json={"room_id": w["room"]})
+    frames = [H.synth_jpeg(i, label=str(i)) for i in range(1, 6)]
+    for f in frames:
+        assert s.post("/student/frame_preview", data=f, headers={"Content-Type": "image/jpeg"}).status_code == 200
+    pro = _client(app, w["pname"])
+    r = pro.get(f"/proctor/student/{w['sid']}/snapshot?source=live")
+    assert r.status_code == 200 and r.data == frames[-1]                 # newest, never an old one
+    assert r.headers["X-Frame-Seq"] == "5" and r.headers["X-Stream-State"] == "live"
+    again = pro.get(f"/proctor/student/{w['sid']}/snapshot?source=live",
+                    headers={"If-None-Match": r.headers["ETag"]})
+    assert again.status_code == 304
+
+
+def test_exam_page_uploads_the_raw_not_the_mirrored_camera_frame():
+    """BEFORE: grabBlob() used setTransform(-1,...) -> uploaded frames were mirrored
+    (verified in Chromium) -> Head/Eyes LEFT and RIGHT were swapped."""
+    html = open(os.path.join(H.ROOT, "templates", "student", "exam.html"), encoding="utf-8").read()
+    body = html[html.index("function grabBlob"):html.index("async function postBlob")]
+    code = "\n".join(line.split("//")[0] for line in body.splitlines())        # ignore comments
+    assert "setTransform(1, 0, 0, 1, 0, 0)" in code and "setTransform(-1" not in code
+    assert "#webcam-feed { transform: scaleX(-1); }" in html            # the student still sees a mirror
+
+
+# ── 4. Face / head / gaze logic ───────────────────────────────────────────────
+def test_face_state_roundtrip_keeps_new_per_student_fields(analyzer):
+    analyzer.set_state(None)
+    analyzer.analyze(cv2.resize(cv2.imread(PHOTO), (320, 240)))
+    st = analyzer.get_state()
+    assert {"_calib_stats", "_orientation_last_valid"} <= set(st)
+    assert st["_calib_stats"]["accepted"] == 1
+    analyzer.set_state(None)
+    assert analyzer.get_state()["_calib_stats"]["accepted"] == 0         # students never share state
+    analyzer.set_state(st)
+    assert analyzer.get_state()["_calib_stats"]["accepted"] == 1
+    legacy = {k: v for k, v in st.items() if k not in ("_calib_stats", "_orientation_last_valid")}
+    analyzer.set_state(legacy)                                           # state saved by an older instance
+
+
+def test_one_ineligible_frame_does_not_restart_calibration(analyzer):
+    """BEFORE: every ineligible frame CLEARED the samples; a real webcam sequence with one
+    low-confidence frame in six only calibrated through the 45 s fallback (46.4 s)."""
+    analyzer.set_state(None)
+    rng = np.random.RandomState(0)
+    t = 1000.0
+    for i in range(40):
+        sample = np.array([0.5, 0.45, -8.0, 2.0, 0.30]) + rng.normal(0, [0.003, 0.003, 0.3, 0.3, 0.003])
+        analyzer._update_calibration(t, sample, eligible=(i % 6 != 3), reason="test")
+        if analyzer._calibrated:
+            break
+        t += 0.8
+    st = analyzer._calib_stats
+    assert analyzer._calibrated and st["method"] == "strict" and st["ready_after_s"] <= 12.0, st
+    assert st["rejected"] >= 1
+
+
+def test_head_direction_is_dominant_and_single_invalid_frame_keeps_duration(analyzer):
+    analyzer.set_state(None)
+    assert analyzer._head_warning(19.0, -50.0) == "Head Left"    # BEFORE: "Head Up" (first match)
+    analyzer.set_state(None)
+    assert analyzer._head_warning(0.0, 30.0) == "Head Right"
+    analyzer.set_state(None)
+    assert analyzer._head_warning(25.0, 5.0) == "Head Up"
+    analyzer.set_state(None)
+    assert analyzer._head_warning(-14.0, 3.0) == "Head Down"
+    analyzer.set_state(None)
+    t, out = 0.0, None
+    for i in range(8):                      # 6.4 s turn at 1.25 fps with ONE invalid frame
+        valid = i != 3
+        out = analyzer._update_orientation(t, "Unknown", "Head Left" if valid else None, False, valid)
+        t += 0.8
+    assert out[0] == "head_deviation" and out[2] >= 5.0 and out[3] == "left", out
+    for _ in range(4):                      # > 2 s without any valid observation -> episode ends
+        analyzer._update_orientation(t, "Unknown", None, False, False)
+        t += 0.8
+    out = analyzer._update_orientation(t, "Unknown", "Head Left", False, True)
+    assert out[2] == 0.0
+
+
+def test_head_quality_does_not_penalise_the_angle(analyzer):
+    """BEFORE: |yaw| > 40 or |pitch| > 35 made the frame 'poor' and head confidence decayed
+    above 20 deg, so a clear, large head turn produced NO head direction at all."""
+    import mediapipe as mp
+    img = cv2.imread(PHOTO)
+    mpi = mp.Image(image_format=mp.ImageFormat.SRGB, data=cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
+    det = analyzer._detector.detect(mpi)
+    boxes = [(d.bounding_box.origin_x, d.bounding_box.origin_y, d.bounding_box.width, d.bounding_box.height)
+             for d in det.detections]
+    lm = analyzer._landmarker.detect(mpi).face_landmarks[0]
+    good = analyzer._head_quality(img, boxes, lm, (0.0, 0.0, 0.0))
+    assert good >= 0.5
+    assert analyzer._head_quality(img, boxes, lm, (5.0, -55.0, 3.0)) == good   # angle is not a defect
+    dark = (img * 0.08).astype(np.uint8)
+    assert analyzer._head_quality(dark, boxes, lm, (0.0, 0.0, 0.0)) < 0.5      # image quality still is
+    assert analyzer._head_quality(img, boxes + boxes, lm, (0.0, 0.0, 0.0)) == 0.0  # two faces
+
+
+# ── 5. Phone ──────────────────────────────────────────────────────────────────
+def test_tracker_keeps_the_original_phone_operating_point():
+    """The tracker is deliberately UNCHANGED (report §11). Its buffer weights each frame by
+    0.55*YOLO + 0.45*verifier, so weak boxes never confirm. Real case at 640x480: a phone with
+    YOLO 0.29-0.35 / verifier ACCEPT 0.46-0.49 stays below 0.40. Recording plain presence instead
+    confirmed that phone, but also a microphone, dark fabric and a coffee cup on real photos.
+    This pins the precision-first behaviour so it is not lowered by accident."""
+    from modules.detection.phone_tracker import PhoneTracker, CONFIRM_THRESHOLD
+    weak = {"box": (100, 100, 30, 40), "confidence": 0.31, "verifier_score": 0.48, "verifier_decision": "ACCEPT"}
+    t = PhoneTracker()
+    for _ in range(6):
+        assert t.update([dict(weak)]) == []               # weak evidence never confirms
+    assert t.get_all_tracks()[0].buffer_score < CONFIRM_THRESHOLD
+    strong = {"box": (100, 100, 30, 40), "confidence": 0.60, "verifier_score": 0.70, "verifier_decision": "ACCEPT"}
+    t2 = PhoneTracker()
+    assert t2.update([dict(strong)]) == []                # one frame is never enough
+    assert len(t2.update([dict(strong)])) == 1            # a clear phone confirms on the 2nd frame
+    t3 = PhoneTracker()
+    t3.update([dict(strong)])
+    for _ in range(3):
+        assert t3.update([]) == []                        # single-frame flash stays unconfirmed
+
+
+def _sim_worker(app, clock):
+    w = _world(app)
+    app.session_manager.start_session(w["sid"], w["sname"], w["room"])
+    return app.session_manager.get_worker(w["sid"]), w
+
+
+def _resume(app, sid):
+    H.flush()
+    mgr = app.session_manager
+    with mgr._lock:
+        mgr._workers.pop(sid)
+    return mgr.ensure_worker(sid)
+
+
+@pytest.mark.parametrize("interval,frames", [(1.0, 40), (3.5, 12)])
+def test_one_phone_episode_adds_70_once_even_with_sparse_ai_frames(app, stub_pool, clock, interval, frames):
+    """BEFORE: at 3.5 s per AI frame (many students, YOLO on CPU) every frame of ONE held phone
+    was a 'new episode' -> cumulative 1.00; and a resume re-counted every event row (0.70 -> 1.00)."""
+    w, info = _sim_worker(app, clock)
+    stub_pool.set_all(phone=H.phone_result(confirmed=True))
+    for _ in range(frames):
+        clock.advance(interval)
+        w._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    assert w._cumulative_at() == pytest.approx(0.70)
+    assert w.events.counts()["by_type"]["phone_detected"] >= 2       # still one event per cooldown
+    assert _resume(app, info["sid"])._cumulative_at() == pytest.approx(0.70)
+
+
+def test_two_separate_phone_episodes_count_twice(app, stub_pool, clock):
+    w, info = _sim_worker(app, clock)
+    for phone, n in ((True, 5), (False, 20), (True, 5)):
+        stub_pool.set_all(phone=H.phone_result(confirmed=phone))
+        for _ in range(n):
+            clock.advance(1.0)
+            w._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    assert w._cumulative_at() == pytest.approx(1.0)                   # 70 + 70, clamped at 100
+
+
+def test_multiple_persons_is_one_episode_with_sparse_frames(app, stub_pool, clock):
+    w, info = _sim_worker(app, clock)
+    stub_pool.set_all(phone=H.phone_result(persons=2))
+    for _ in range(18):
+        clock.advance(3.5)
+        w._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    assert w._cumulative_at() == pytest.approx(0.55)
+    assert _resume(app, info["sid"])._cumulative_at() == pytest.approx(0.55)
+
+
+# ── 6. Audio / integrity contribute to cumulative risk consistently ───────────
+def test_audio_and_integrity_events_add_cumulative_and_survive_resume(app, stub_pool, clock):
+    """BEFORE: speech / integrity events raised only CURRENT risk live, but the resume and
+    finalise paths counted them -> cumulative jumped 0.00 -> 0.53 after a worker restart."""
+    w, info = _sim_worker(app, clock)
+    for _ in range(2):
+        clock.advance(1.0)
+        w.ingest_audio({"event": "speech", "confidence": 0.95, "is_suspicious": True, "backend": "YAMNet"})
+    assert w._cumulative_at() == pytest.approx(0.20)
+    clock.advance(1.0)
+    w.record_integrity("tab_hidden")
+    w.record_integrity("tab_visible")                      # informational: +0
+    assert w._cumulative_at() == pytest.approx(0.53)
+    assert _resume(app, info["sid"])._cumulative_at() == pytest.approx(0.53)
+
+
+# ── 7. Current / cumulative / final ───────────────────────────────────────────
+def test_current_low_cumulative_70_overall_high_final_70(app, stub_pool, clock):
+    w = _world(app)
+    s, pro = _client(app, w["sname"]), _client(app, w["pname"])
+    assert s.post("/student/session/start", json={"room_id": w["room"]}).status_code == 200
+    worker = app.session_manager.get_worker(w["sid"])
+    stub_pool.set_all(phone=H.phone_result(confirmed=True))
+    for _ in range(3):
+        clock.advance(1.0)
+        worker._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    stub_pool.set_all(phone=H.phone_result())
+    for _ in range(40):                                    # 20 calm minutes
+        clock.advance(30.0)
+        worker._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    st = s.get("/student/status").get_json()
+    assert st["current_level"] == "Low" and st["current_risk"] < 0.30
+    assert st["cumulative_risk"] == pytest.approx(0.70) and st["overall_level"] == "High"
+    card = pro.get("/proctor/students/poll").get_json()[0]
+    assert card["cumulative_risk"] == pytest.approx(0.70) and card["overall_level"] == "High"
+    stop = s.post("/student/session/stop").get_json()
+    assert stop["final_risk"] == pytest.approx(0.70) and stop["final_level"] == "High"
+    sess = pro.get("/proctor/sessions").get_json()["sessions"][0]
+    assert sess["completed"] and sess["final_score"] == pytest.approx(0.70) and sess["final_risk"] == "High"
+
+
+# ── 8. Refresh / logout / reconnect keep the SAME exam session ────────────────
+def test_refresh_and_relogin_continue_the_same_session_and_cumulative(app, stub_pool, clock):
+    """BEFORE: a page refresh (re-join) or logout + login finalised the session and started a
+    new one at 0 % cumulative risk."""
+    w = _world(app)
+    s = _client(app, w["sname"])
+    s1 = s.post("/student/session/start", json={"room_id": w["room"]}).get_json()["session_id"]
+    worker = app.session_manager.get_worker(w["sid"])
+    stub_pool.set_all(phone=H.phone_result(confirmed=True))
+    clock.advance(1.0)
+    worker._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    stub_pool.set_all(phone=H.phone_result())
+    H.flush()
+    r = s.post("/student/session/start", json={"room_id": w["room"]}).get_json()          # refresh
+    assert r["session_id"] == s1 and r["cumulative_risk"] == pytest.approx(0.70)
+    s.get("/auth/logout")                                                                   # suspend
+    assert app.session_manager.get_worker(w["sid"]) is None
+    from db_models import ExamSession
+    with app.app_context():
+        assert ExamSession.query.get(s1).ended_at is None
+    s = _client(app, w["sname"])
+    r = s.post("/student/session/start", json={"room_id": w["room"]}).get_json()
+    assert r["session_id"] == s1 and r["cumulative_risk"] == pytest.approx(0.70)
+    s.post("/student/session/stop")
+    with app.app_context():
+        row = ExamSession.query.get(s1)
+        assert row.ended_at is not None and row.final_score == pytest.approx(0.70)
+
+
+def test_suspended_session_is_finalised_with_cumulative_when_the_student_never_returns(app, stub_pool, clock):
+    w = _world(app)
+    s = _client(app, w["sname"])
+    s1 = s.post("/student/session/start", json={"room_id": w["room"]}).get_json()["session_id"]
+    worker = app.session_manager.get_worker(w["sid"])
+    stub_pool.set_all(phone=H.phone_result(persons=2))
+    clock.advance(1.0)
+    worker._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    H.flush()
+    s.get("/auth/logout")
+    pro = _client(app, w["pname"])
+    card = pro.get("/proctor/students/poll").get_json()[0]                 # still visible, reconnecting
+    assert card["db_only"] and card["cumulative_risk"] == pytest.approx(0.55)
+    mgr = app.session_manager
+    mgr.resume_window = 0.0
+    from db_models import ExamSession
+    with app.app_context():
+        mgr._utc_naive_now = staticmethod(lambda: datetime.datetime.utcnow() + datetime.timedelta(minutes=10))
+        assert mgr.close_stale_sessions() == 1
+        row = ExamSession.query.get(s1)
+        assert row.ended_at is not None and row.final_score == pytest.approx(0.55) and row.final_risk == "Medium"
+
+
+# ── 9. PROCTOR_DIAG records explain suppression ───────────────────────────────
+def test_diag_records_every_frame_with_suppression_reasons(app, stub_pool, clock):
+    w, info = _sim_worker(app, clock)
+    recs = []
+    w.diag_hook = recs.append
+    stub_pool.set_all(face=H.face_result(orientation_state="head_deviation", orientation_confidence=0.5,
+                                         orientation_duration=1.5, orientation_direction="left"))
+    clock.advance(1.0)
+    w._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    rec = recs[-1]
+    assert rec["kind"] == "frame" and json.dumps(to_json_safe(rec))
+    reason = {s["type"]: s["reason"] for s in rec["signals"]}["orientation_deviation"]
+    assert "held 1.5s < 4s" in reason
+    stub_pool.set_all(face=H.face_result(orientation_state="head_deviation", orientation_confidence=0.5,
+                                         orientation_duration=4.5, orientation_direction="left"))
+    clock.advance(1.0)
+    w._run_pipeline(np.zeros((240, 320, 3), np.uint8))
+    sig = {s["type"]: s for s in recs[-1]["signals"]}["orientation_deviation"]
+    assert sig["emitted"] and "new episode" in sig["reason"]
+    w.ingest_audio({"event": "speech", "confidence": 0.9, "is_suspicious": True, "backend": "YAMNet"})
+    assert recs[-1]["kind"] == "audio" and "waiting for confirmation" in recs[-1]["reason"]
